# Server-only: never prefix these names with VITE_.
# Create an API key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional fallback, e.g. deepseek-v4-pro; disabled by default.
DEEPSEEK_FALLBACK_MODEL=
# Required in Vercel Production: shared rate limiter (10 requests / IP / minute).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional anonymous chat history (server-only). Apply migrations/d1/0001_chat_turns.sql first.
CHAT_LOG_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

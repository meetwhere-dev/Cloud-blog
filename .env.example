# Server-only: never prefix these names with VITE_.
# Use a Google AI Studio free-tier project key to use its free quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set to an empty value to disable fallback.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Required in Vercel Production: shared rate limiter (10 requests / IP / minute).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

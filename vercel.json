{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.mjs": {
      "maxDuration": 60,
      "includeFiles": "server/generated/knowledge.json",
      "supportsCancellation": true
    }
  },
  "cleanUrls": true
}
